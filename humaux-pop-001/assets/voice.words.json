 "sentences": [
  {
   "text": "Your AI has amnesia.",
   "start": 0,
   "end": 1.178
  },
  {
   "text": "Every single time.",
   "start": 1.428,
   "end": 2.491
  },
  {
   "text": "You brief it on Monday.",
   "start": 2.741,
   "end": 3.856
  },
  {
   "text": "By Friday, it's a stranger again.",
   "start": 4.106,
   "end": 5.802
  },
  {
   "text": "You told it last week.",
   "start": 6.052,
   "end": 7.131
  },
  {
   "text": "It has no idea what you mean.",
   "start": 7.381,
   "end": 8.682
  },
  {
   "text": "That's not a model problem.",
   "start": 8.932,
   "end": 10.214
  },
  {
   "text": "It's a memory problem.",
   "start": 10.463,
   "end": 11.588
  },
  {
   "text": "Humaux is memory for AI agents.",
   "start": 11.838,
   "end": 13.827
  },
  {
   "text": "Cross-session.",
   "start": 14.077,
   "end": 14.845
  },
  {
   "text": "Your agent remembers what you told it last week, last month, last project.",
   "start": 15.095,
   "end": 18.803
  },
  {
   "text": "On this channel, no hype.",
   "start": 19.053,
   "end": 20.348
  },
  {
   "text": "Just real builds, real failures, and real numbers.",
   "start": 20.599,
   "end": 23.185
  },
  {
   "text": "No more repeating yourself.",
   "start": 23.435,
   "end": 24.685
  },
  {
   "text": "No more starting from zero.",
   "start": 24.935,
   "end": 26.266
  },
  {
   "text": "Memory, once.",
   "start": 26.517,
   "end": 27.363
  },
  {
   "text": "Everywhere.",
   "start": 27.613,
   "end": 28.202
  }
 ],
